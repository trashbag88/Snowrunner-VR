// Names the DLL in Explorer's Details tab, so a dxgi.dll in the game folder says
// which build it is (SnowRunner-ModSwitch.ps1 reads FileDescription too).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#if SRVR_TRACKIR
            VALUE "FileDescription", "SnowRunner TrackIR (flat-screen fork of SnowRunner VR)"
            VALUE "ProductName", "SnowRunner TrackIR"
#else
            VALUE "FileDescription", "SnowRunner VR"
            VALUE "ProductName", "SnowRunner VR"
#endif
            VALUE "FileVersion", "0.1.1"
            VALUE "OriginalFilename", "dxgi.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
